# Copy to .env and fill in. Never commit .env.
CTN_TEAM_CODE=TEAMCODE123456
CTN_SIDE=Vote Yes

# 1 = print what would be posted, 0 = actually post
CTN_DRY_RUN=1

# seconds between rounds of one bot
CTN_LOOP_SECONDS=60

# post an original (non-reply) every N rounds
CTN_ORIGINAL_EVERY=4

# LLM: competition (qwen2.5-3b, 3 req/min team-wide) or ollama (local, falls back to competition)
CTN_LLM=competition
CTN_OLLAMA_MODEL=qwen2.5:7b
CTN_DRAFTS=3
